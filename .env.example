# --- LLM ---
LLM_PROVIDER=anthropic          # anthropic | openai | google | mock
MODEL=claude-3-5-sonnet-20241022   # set to a model your key can access
ANTHROPIC_API_KEY=your-key-here
# OPENAI_API_KEY=your-key-here
# GOOGLE_API_KEY=your-key-here   # if using google, prefer MODEL=gemini-flash-latest
                                  # (pinned versions like gemini-2.5-flash hit a hard
                                  # 20-requests/day free-tier cap; -latest aliases move
                                  # as Google deprecates models, avoiding 404s too)

# --- Retrieval ---
RETRIEVER=tfidf                 # tfidf (default, no download) | faiss
TOP_K=4
CHUNK_WORDS=80
GROUNDING_THRESHOLD=0.08        # raise to refuse more aggressively
USE_LLM_GRADER=false            # true = add an LLM sufficiency check

# --- Lesson source for the API (optional) ---
LESSON_FILE=data/sample_transcript.json
# LESSON_YOUTUBE=https://youtu.be/VIDEO_ID

# --- Proxy for YouTube caption fetch (optional) ---
# Use if YouTube starts blocking your IP after repeated /ingest calls.
# Option A: Webshare.io rotating proxies (recommended by youtube-transcript-api)
# WEBSHARE_PROXY_USERNAME=your-webshare-username
# WEBSHARE_PROXY_PASSWORD=your-webshare-password
# Option B: any HTTP/HTTPS proxy you already have
# HTTP_PROXY_URL=http://user:pass@host:port
# HTTPS_PROXY_URL=http://user:pass@host:port
